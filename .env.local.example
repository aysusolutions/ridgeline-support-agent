# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.
# Neither key is required — with both absent the agent runs its deterministic path.

# https://console.groq.com/keys  (free, no card)
GROQ_API_KEY=

# https://aistudio.google.com/apikey  (free, no card)
GEMINI_API_KEY=
